# =============================================================================
# VillaGo — front web
#
# Deux familles de variables, à ne pas confondre :
#
#   DJANGO_API_URL   lue par le serveur Express AU DÉMARRAGE.
#   VITE_*           figées par Vite AU MOMENT DU BUILD, et incluses en clair
#                    dans le JavaScript livré au navigateur. Ce sont des
#                    constantes publiques : n'y placez jamais un secret.
#
# Les définir dans docker-compose n'a aucun effet sur les VITE_* : elles se
# passent en arguments de build (voir Dockerfile et docker-compose.prod.yml).
# =============================================================================

PORT=5000
NODE_ENV=development

# --- Serveur Express ----------------------------------------------------------
# URL de l'API Django. OBLIGATOIRE en production : si elle est vide, le serveur
# refuse de démarrer, parce qu'il servirait sinon des données de démonstration
# avec une authentification qui accepte n'importe quel mot de passe.
# Ne la laisser vide qu'en développement, pour travailler sans backend.
DJANGO_API_URL=

# --- Build du client ----------------------------------------------------------
# Base des appels API depuis le navigateur.
#   - en production : vide, le proxy Express relaie /api/v1 vers Django
#   - en test sur Vercel : l'URL Render complète, car il n'y a pas de proxy
VITE_API_URL=

# Base des URL de médias (photos de biens, avatars). OBLIGATOIRE au build de
# production : sans elle, toutes les images sont cassées.
VITE_DJANGO_API_URL=https://api.villago.cd
